struct segm {
private:
    struct node_val {
        ll mn = INTINF, cnt = 0;
        node_val() {
            mn = INTINF;
            cnt = 0;
        }
        node_val(ll _cnt, ll _mn) {
            cnt = _cnt;
            mn = _mn;
        }
    };

    struct node {
        ll ind = -1, lchild = -1, rchild = -1;
        ll p = 0;
        node_val val;
        node() {
            lchild = rchild = -1;
            ind = -1;
            p = 0;
            val = node_val();
        }
        node(ll _ind, node_val _val) {
            val = _val;
            ind = _ind;
            lchild = rchild = -1;
            p = 0;
        }
    };

    node_val merge(node_val a, node_val b) {
        if (a.mn < b.mn) return a;
        if (a.mn > b.mn) return b;
        return node_val(a.cnt + b.cnt, a.mn);
    }

    vec <node> g;
    ll n;

    bool have_childs(ll ind) {
        return g[ind].lchild != -1 && g[ind].rchild != -1;
    }
    void add_childs(ll par, ll l, ll r) {
        ll nm = (l + r) >> 1ll;

        node lchild(g.size(), node_val(nm - l, 0));
        g.push_back(lchild);
        node rchild(g.size(), node_val(r - nm, 0));
        g.push_back(rchild);

        g[par].lchild = lchild.ind;
        g[par].rchild = rchild.ind;
    }

    void apply(ll v, ll val) {
        g[v].p += val;
    }
    void push(ll v, ll l, ll r) {
        if (r - l == 1) {
            g[v].val.mn += g[v].p;
            g[v].p = 0;
            return;
        }
        if (!have_childs(v)) add_childs(v, l, r);
        apply(g[v].lchild, g[v].p);
        apply(g[v].rchild, g[v].p);
        g[v].val.mn += g[v].p;
        g[v].p = 0;
    }

    void update(ll v, ll l, ll r, ll gll, ll glr, ll val) {
        push(v, l, r);
        if (glr <= l || r <= gll) return;
        if (gll <= l && r <= glr) {
            apply(v, val);
            push(v, l, r);
            return;
        }
        ll nm = (l + r) >> 1ll;
        update(g[v].lchild, l, nm, gll, glr, val);
        update(g[v].rchild, nm, r, gll, glr, val);
        g[v].val = merge(g[g[v].lchild].val, g[g[v].rchild].val);
    }
/*
    node_val get(ll v, ll l, ll r, ll gll, ll glr) {
        push(v, l, r);
        if (glr <= l || r <= gll) return node_val();
        if (gll <= l && r <= glr) return g[v].val;
        ll nm = (l + r) >> 1ll;
        return merge(get(g[v].lchild, l, nm, gll, glr), get(g[v].rchild, nm, r, gll, glr));
    }*/

public:
    ll n2;

    segm(){}
    segm(ll _n) {
        n = _n;
        n2 = 1ll << (ll)(ceil(log2(n)) + 1ll);
        node root(0, node_val(n2 / 2ll, 0));
        g.push_back(root);
    }

    void update(ll l, ll r, ll val) {
        update(0, 0, n2 / 2ll, l, r, val);
    }
    ll get() {
        node_val res = g[0].val;
        if (res.mn == 0) {
            return n2 / 2ll - res.cnt;
        }
        return n2 / 2ll;
    }
};

struct event {
    int type;
    ll up, down, x;

    event() {}
    event(int _down, int _up, int _x, int _t) {
        x = _x;
        up = _up;
        down = _down;
        type = _t;
    }
};

bool cmp(event& a, event& b) {
    return a.type < b.type;
}

signed main() {
    FAST();

    segm tree(INTINF);

    int n;
    cin >> n;
    vec <vec <int>> sq(n, vec <int>(4));
    cin >> sq;
    //x0 - x1, x1 - y1, x2 - x2, x3 - y2

    map <int, vec <event>> events;
    for (const auto& x : sq) {
        events[x[0]].push_back(event(x[1], x[3], x[0], 1));
        events[x[2]].push_back(event(x[1], x[3], x[2], -1));
    }

    ll oldx = events.begin()->first;
    ll ans = 0;
    for (auto& p : events) {
        sort(p.second.begin(), p.second.end(), cmp);
        ll newx = p.first;
        ans += (newx - oldx) * tree.get();
        for (event& e : p.second) {
            tree.update(e.down, e.up, e.type);
        }
        oldx = newx;
    }

    cout << ans;
}

#include <iostream>
#include <bits/stdc++.h>

using namespace std;

using ll = long long;
using ld = long double;
using pii = pair <int, int>;
using pll = pair <ll, ll>;
using vi = vector <int>;

template <typename T>
using vec = vector <T>;

const ll llinf = 1e18 + 5;
const int intinf = 1e9 + 5;
const ll MOD = 1e9 + 7;

void FAST() {
    cin.tie(0);
    ios::sync_with_stdio(false);
}

void dfs(int v, vec <bool>& used, vec <vi>& g, int& ans) {
    if (ans >= 1e6) return;
    used[v] = 1;
    ans++;
    for (int x : g[v]) {
        if (!used[x]) dfs(x, used, g, ans);
    }
    used[v] = 0;
}

int main() {
    FAST();

    int n, m;
    cin >> n >> m;

    vec <vi> g(n);
    for (int i = 0, a, b; i < m; i++) {
        cin >> a >> b;
        a--, b--;
        g[a].push_back(b), g[b].push_back(a);
    }

    vec <bool> used(n);
    int ans = 0;
    dfs(0, used, g, ans);

    cout << ans;
}

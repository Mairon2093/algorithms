template <typename T>
struct sparce_table {
private:
    const int logn = 25;
    vector <vector <int>> dp;
    int n;

    sparce_table() {}
    sparce_table(vi& a) {
        n = a.size();
        dp = vector <vi>(logn, vi(n));

        for (int i = 0; i < a.size(); i++) dp[0][i] = a[i];
        for (int st = 1; st < logn; st++) {
            for (int i = 1; i < a.size(); i++) {
                if (i + (1 << (st - 1)) >= a.size()) {
                    dp[st][i] = min(dp[st - 1][i], a[a.size() - 1]);
                }
                else {
                    dp[st][i] = min(dp[st - 1][i], dp[st - 1][i + (1 << (st - 1))]);
                }
            }
        }
    }

    int get(int l, int r) {
        if (l > r) swap(l, r);
        r++;
        int k = __lg(r - l);
        return min(dp[k][l], dp[k][r - (1 << k)]);
    }
};


template <typename T>
struct Point {
    T x, y;
    Point() {
        x = y = 0;
    }
    template <typename Y>
    Point(Y _x, Y _y) {
        x = _x;
        y = _y;
    }

    bool operator ==(Point b) {
        return equal(x, b.x) && equal(y, b.y);
    }
    T operator *(Point b) {
        return x * b.x + y * b.y;
    }
    T operator ^(Point b) {
        return x * b.y - y * b.x;
    }
    Point operator /(ld b) {
        if (equal(b, 0)) {
            cerr << "divided by zero";
            exit(139);
        }
        return Point(x / b, y / b);
    }
    Point operator +(Point b) {
        return Point(x + b.x, y + b.y);
    }
    Point operator -(Point b) {
        return Point(x - b.x, y - b.y);
    }
    void operator-=(Point b) {
        x -= b.x;
        y -= b.y;
    }
    void operator +=(Point b) {
        x += b.x;
        y += b.y;
    }
    template <typename Y>
    void operator =(Point <Y> B) {
        x = B.x;
        y = B.y;
    }

    ld len() {
        return sqrtl(x * x + y * y);
    }
    T len2() {
        return x * x + y * y;
    }
};
template <typename T>
istream& operator>>(istream& in, Point <T>& a) {
    in >> a.x >> a.y;
    return in;
}
template <typename T>
ostream& operator<<(ostream& out, Point <T> a) {
    out << fixed << setprecision(SIGNS_CNT) << a.x << " " << a.y;
    return out;
}

template <typename T>
ld sinus(Point <T> A, Point <T> B) {
    if (equal(A.len() * B.len(), 0)) {
        cerr << "divided by zero";
        exit(139);
    }
    return (ld)abs(A ^ B) / (A.len() * B.len());
}
template <typename T>
ld cosinus(Point <T> A, Point <T> B) {
    if (equal(A.len() * B.len(), 0)) {
        cerr << "divided by zero";
        exit(139);
    }
    return (ld)(A * B) / (A.len() * B.len());
}
template <typename T>
ld angle(Point <T> A, Point <T> B) { //угол между vector A and vector B
    return atan2l(sinus(A, B), cosinus(A, B));
}

template <typename T>
bool collinear(Point <T> A, Point <T> B) {
    return equal(A ^ B, 0);
}
template <typename T>
bool co_directed(Point <T> A, Point <T> B) {
    return equal(A ^ B, 0) && equal(A * B, A.len() * B.len());
}

/**
 * angle ABC < 180;
 * point P
 */
template <typename T>
bool point_in_angle(Point <T> A, Point <T> B, Point <T> C, Point <T> P) { //ok
    A -= B;
    C -= B;
    P -= B;
    B -= B;

    ld p1 = A ^ P;
    ld p2 = P ^ C;
    ld p3 = A ^ C;

    if (sign(p1) == -1) {
        p1 *= -1;
        p2 *= -1;
        p3 *= -1;
    }
    return p1 >= 0 && p2 >= 0 && p3 >= 0;
}
template <typename T>
bool point_in_triangle(Point <T> A, Point <T> B, Point <T> C, Point <T> P) {
    return point_in_angle(A, B, C, P) && point_in_angle(A, C, B, P) && point_in_angle(C, B, A, P);
}

template <typename T>
struct Segment {
    Point <T> A, B;

    Segment() {}
    template <typename Y>
    Segment(Point <Y> _A, Point <Y> _B) {
        A = _A;
        B = _B;
    }
};

/**
 * n - направляющий вектор прямой;
 * A - точка на прямой
 */
// ax + by + c = 0 -> r = nt + A
template <typename T>
struct Line {
    Point <T> n;
    Point <T> A;
    ld a, b, c;

    Line() {}
    /**
     * a, b, c - коэффициенты уравнения прямой ax + by + c = 0
     */
    Line(T _a, T _b, T _c) {
        a = _a, b = _b, c = _c;
        if (equal(a * a + b * b, 0)) {
            cerr << "invalid line";
            exit(139);
        }
        if (equal(a, 0)) {
            n = Point((T)1, (T)0);
            A = Point((T)1, -c / b);
        } else {
            n = Point(-b / a, (T)1);
            A = Point(-c / a, (T)0);
        }
    }
    //P, Q - точки на прямой
    Line(Point <T> P, Point <T> Q) {
        n = Q - P;
        A = P;
        a = P.y - Q.y;
        b = Q.x - P.x;
        c = -Q.x * P.y + Q.y * P.x;
    }
};

/**
 * A - стартовая точка;
 * n - направляющий вектор луча
 */
template <typename T>
struct Beam {
    Point <T> A;
    Point <T> n;

    Beam() {}
    template <typename Y>
    Beam(Point <Y> start, Point <Y> on_beam) {
        A = start;
        n = on_beam - start;
    }
};

struct Intersection_point {
    Point <ld> P;
    bool exist;
    Intersection_point() {
        exist = false;
        P = Point <ld>(0, 0);
    }
    Intersection_point(bool fl) {
        exist = fl;
        assert(fl == false);
        P = Point <ld>(0, 0);
    }
    Intersection_point(Point <ld> intersection_point) {
        exist = true;
        P = intersection_point;
    }
};

// intersection point of line - line
template <typename T>
Intersection_point intersection_point(Line <T> a, Line <T> b) {
    ld x = (a.b * b.c - b.b * a.c) / (a.a * b.b - b.a * a.b);
    ld y = -(a.a * b.c - b.a * a.c) / (a.a * b.b - b.a * a.b);
    return Intersection_point(Point <ld>(x, y));
}

template <typename T>
bool check_intersection(Line <T> line1, Line <T> line2) { // ok
    if (collinear(line1.n, line2.n)) {
        return collinear(line1.A - line2.A, line1.n);
    }
    return 1;
}
template <typename T>
bool check_intersection(Line <T> line, Point <T> P) { // ok
    return co_directed(P - line.A, line.n);
}

template <typename T>
bool check_intersection(Segment <T> segm, Point <T> P) { // ok
    return (co_directed(P - segm.A, segm.B - segm.A) && co_directed(P - segm.B, segm.A - segm.B));
}
template <typename T>
bool check_intersection(Segment <T> segm, Line <T> line) {
    ld p1 = line.n ^ (segm.A - line.A);
    ld p2 = line.n ^ (segm.B - line.A);
    if (p1 < 0) {
        p1 *= -1;
        p2 *= -1;
    } else if (equal(p1, 0)) {
        return 1;
    }
    return p1 >= 0 && p2 <= 0;
}

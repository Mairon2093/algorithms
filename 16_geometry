template <typename T>
bool check_intersection(Beam <T> beam, Point <T> A) { //ok
    return co_directed(A - beam.A, beam.n);
}
template <typename T>
bool check_intersection(Beam <T> beam, Segment <T> segm) {
    Line <T> l1(beam.A, beam.A + beam.n);
    Line <T> l2(segm.A, segm.B);
    Intersection_point inter = intersection_point(l1, l2);
    if (!inter.exist) return false;
    return check_intersection(Beam <ld>(beam.A, beam.A + beam.n), inter.P) &&
           check_intersection(Segment <ld>(segm.A, segm.B), inter.P);
}
template <typename T>
bool check_intersection(Beam <T> beam, Line <T> line) { //ok m wa4 -> wa16
    if (check_intersection(line, beam.A)) return 1;
    return sign(line.n ^ (beam.A - line.A)) * sign(line.n ^ beam.n) < 0;
}
template <typename T>
bool check_intersection(Beam <T> beam1, Beam <T> beam2) { //ok
    if (collinear(beam1.n, beam2.n)) {
        return check_intersection(beam1, beam2.A) || check_intersection(beam2, beam1.A);
    }
    if (check_intersection(beam1, beam2.A) || check_intersection(beam2, beam1.A)) return 1;
    return sign(beam1.n ^ beam2.n) * sign(beam1.n ^ (beam2.A - beam1.A)) < 0 &&
           sign(beam2.n ^ beam1.n) * sign(beam2.n ^ (beam1.A - beam2.A)) < 0;
}

// point - point OK
template <typename T>
ld dist(Point <T> a, Point <T> b) {
    return sqrtl((a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y));
}
template <typename T>
ll dist2(Point <T> a, Point <T> b) {
    return (a.x - b.x) * (a.x - b.x) + (a.y - b.y) * (a.y - b.y);
}
// line - point OK
template <typename T>
ld dist(Line <T> line, Point <T> P) {
    if (P == line.A) return 0;
    return dist(line.A, P) * sinus(line.n, P - line.A);
}
// line - line OK
template <typename T>
ld dist(Line <T> line1, Line <T> line2) {
    if (check_intersection(line1, line2)) return 0;
    return dist(line1, line2.A);
}
// segment - point OK
template <typename T>
ld dist(Segment <T> segm, Point <T> P) {
    if (check_intersection(segm, P)) return 0;
    ld d = min(dist(segm.A, P), dist(P, segm.B));
    if (segm.A == segm.B) return d;

    if (cosinus(P - segm.A, segm.B - segm.A) >= 0 && cosinus(P - segm.B, segm.A - segm.B) >= 0) {
        d = min(d, dist(Line(segm.A, segm.B), P));
    }
    return d;
}
// segment - line OK
template <typename T>
ld dist(Segment <T> segm, Line <T> line) {
    if (check_intersection(segm, line)) return 0;
    return min(dist(line, segm.A), dist(line, segm.B));
}
// segment - segment OK
template <typename T>
ld dist(Segment <T> segm1, Segment <T> segm2) {
    if (check_intersection(segm1, segm2)) return 0;
    ld d = min({
        dist(segm2, segm1.A),
        dist(segm2, segm1.B),
        dist(segm1, segm2.A),
        dist(segm1, segm2.B)
    });
    return d;
}
// beam - point OK
template <typename T>
ld dist(Beam <T> beam, Point <T> P) {
    ld d = dist(beam.A, P);
    if ((P - beam.A) * beam.n >= 0) d = min(d, dist(Line <T>(beam.A, beam.A + beam.n), P));
    return d;
}
// beam - segment OK
template <typename T>
ld dist(Beam <T> beam, Segment <T> segm) {
    if (check_intersection(beam, segm)) return 0;
    return min({dist(beam, segm.A), dist(beam, segm.B), dist(segm, beam.A)});
}
// beam - line OK
template <typename T>
ld dist(Beam <T> beam, Line <T> line) {
    if (check_intersection(beam, line)) return 0;
    return dist(line, beam.A);
}
// beam - beam OK
template <typename T>
ld dist(Beam <T> beam1, Beam <T> beam2) {
    if (check_intersection(beam1, beam2)) return 0;
    return min(dist(beam2, beam1.A), dist(beam1, beam2.A));
}


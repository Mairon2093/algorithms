struct lca {
    vec <vec <int>> g;
    int n;

    vec <int> tin, tout, path;
    vec <vec <int>> binups;

    void dfs_count(int v, int p, int& cl) {
        tin[v] = cl++;
        path.push_back(v);
        for (int x : g[v]) {
            if (x != p) dfs_count(x, v, cl);
        }
        tout[v] = cl++;
    }

    lca() {}
    lca(vec <vec <int>>& _g) {
        g = _g;
        n = g.size();

        tin = vec <int>(n);
        tout = vec <int>(n);
        binups = vec <vec <int>>(logn, vec <int>(n, INTINF));
        int cl = 0;
        dfs_count(0, 0, cl);
    }

    bool anc(int p, int v) {
        return tin[p] <= tin[v] && tout[v] <= tout[p];
    }
    int get_lca(int a, int b) {
        if (anc(a, b)) return a;
        if (anc(b, a)) return b;
        for (int i = logn - 1; i >= 0; i--) {
            if (!anc(binups[i][a], b)) {
                a = binups[i][a];
            }
        }
        return binups[0][a];
    }
};


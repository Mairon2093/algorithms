struct dd_set {
private:
    struct node {
        int prior, val, sum;
        node* l;
        node* r;
        node() {
            sum = prior = val = 0;
            l = r = nullptr;
        }
        node(int _val) {
            val = sum = _val;
            prior = rnd(seed);
            l = r = 0;
        }
    };

    node* root = 0;

    int get_sum(node* v) {
        if (v == nullptr) return 0;
        return v->sum;
    }
    void update_node(node* v) {
        if (v == nullptr) return;
        v->sum = get_sum(v->l) + get_sum(v->r);
    }

    pair <node*, node*> split(node* v, int val) {
        if (v == 0) return {0, 0};
        if (v->val <= val) {
            pair <node*, node*> res = split(v->r, val);
            v->r = res.first;
            update_node(v);
            return {v, res.second};
        } else {
            pair <node*, node*> res = split(v->l, val);
            v->l = res.second;
            update_node(v);
            return {res.first, v};
        }
    }

    node* merge(node* L, node* R) {
        if (L == nullptr) return R;
        if (R == nullptr) return L;

        if (L->prior < R->prior) {
            R->l = merge(L, R->l);
            update_node(R);
            return R;
        } else {
            L->r = merge(L->r, R);
            update_node(L);
            return L;
        }
    }
    void print(node* v) {
        if (!v) return;
        print(v->l);
        cout << v->val << " ";
        print(v->r);
    }

public:
    dd_set() {}
    void print() {
        print(root);
    }
    void add(int val) {
        node* newnode = new node(val);
        pair <node*, node*> cut1 = split(root, val);
        root = merge(merge(cut1.first, newnode), cut1.second);
    }
    int final_cut(int l, int r) { // [l, r)
        pair <node*, node*> cut1 = split(root, r);
        pair <node*, node*> cut2 = split(cut1.first, l - 1);
        int ans = get_sum(cut2.second);
        root = merge(merge(cut2.first, cut2.second), cut1.second);
        return ans;
    }
};

struct dd_ordered_set {
private:
    struct node {
        int sz, val, prior;
        node* l,* r;
        node() {
            l = r = nullptr;
            sz = 0, val = 0, prior = 0;
        }
        node(int _val) {
            val = _val;
            sz = 1;
            l = r = 0;
            prior = rnd(seed);
        }
    };

    map <int, node*> used;
    node* root = nullptr;

    int get_sz(node* v) {
        if (!v) return 0;
        return v->sz;
    }
    void update_node(node* v) {
        if (!v) return;
        v->sz = 1 + get_sz(v->l) + get_sz(v->r);
    }

    node* merge(node* L, node* R) {
        if (L == nullptr) return R;
        if (R == nullptr) return L;

        if (L->prior <= R->prior) {
            R->l = merge(L, R->l);
            update_node(R);
            return R;
        } else {
            L->r = merge(L->r, R);
            update_node(L);
            return L;
        }
    }
    pair <node*, node*> split(node* v, int ind) {
        if (!v) return {0, 0};
        if (get_sz(v->l) + 1 <= ind) { //
            pair <node*, node*> c1 = split(v->r, ind - (get_sz(v->l) + 1));
            v->r = c1.first;
            update_node(v);
            return {v, c1.second};
        } else { // ind < get_sz(v->l)
            pair <node*, node*> c1 = split(v->l, ind);
            v->l = c1.second;
            update_node(v);
            return {c1.first, v};
        }
    }
    void print(node* v) {
        if (!v) return;
        print(v->l);
        cout << v->val << " ";
        print(v->r);
    }

public:
    dd_ordered_set() {}
    void print() {
        print(root);
    }
    int findKth(node* v, int ind) {
        if (!v) return INTINF;
        if (get_sz(v->l) >= ind) return findKth(v->l, ind);
        if (get_sz(v->l) + 1 == ind) return v->val;
        return findKth(v->r, ind - 1 - get_sz(v->l));
    }
    void add(int val, int ind) {
        node* newnode = new node(val);
        used[val] = newnode;
        pair <node*, node*> finalcut = split(root, ind);
        //cout << "add " << get_sz(finalcut.first) << " " << get_sz(finalcut.second) << endl;
        root = merge(finalcut.first, merge(newnode, finalcut.second)); //
    }
    int cut(int l, int r) { // [l, r)
        pair <node*, node*> cut1 = split(root, r);
        pair <node*, node*> cut2 = split(cut1.first, l);
        int ans = get_sz(cut2.second);
        root = merge(cut2.first, merge(cut2.second, cut1.second));
        return ans;
    }
    node* del(node* v, int val, unordered_map <int, node*>& G) {
        used[val] = 0;
        pair <node*, node*> p1 = split(v, val);

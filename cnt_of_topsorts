template <typename T>
istream& operator>>(istream& in, vector <T>& a) {
    for (int i = 0; i < a.size(); i++) in >> a[i];
    return in;
}
template <typename T>
ostream& operator<<(ostream& out, vector <T>& a) {
    for (int i = 0; i < a.size(); i++) out << a[i] << " ";
    return out;
}
